{:deps  {outskirtslabs/bb-tasks
         {:git/url "https://github.com/outskirtslabs/bb-tasks"
          :git/sha "9dbc6d77384b51ffde69007e98a0420b3cf6a0a7"}}
 :pods  {clj-kondo/clj-kondo {:version "2026.01.19"}}
 :paths ["scripts"]
 :tasks {:requires
         ([babashka.fs :as fs]
          [babashka.tasks :refer [shell]]
          [clojure.pprint :refer [print-table]]
          [clojure.string :as str]
          [ol.bb-tasks.gen-docs :as gen-docs]
          [ol.bb-tasks.publish-clojars :as publish-clojars]
          [ol.protocol53.release :as release])

         :init (do (def paths ["build.clj"
                               "bb.edn"
                               "api/src/main"
                               "api/src/test"
                               "providers/cloudflare/src/main"
                               "providers/cloudflare/src/test"
                               "providers/cloudflare/src/test-integration"
                               "providers/desec/src/main"
                               "providers/desec/src/test"
                               "providers/desec/src/test-integration"
                               "providers/godaddy/src/main"
                               "providers/godaddy/src/test"
                               "providers/godaddy/src/test-integration"
                               "providers/porkbun/src/main"
                               "providers/porkbun/src/test"
                               "providers/porkbun/src/test-integration"
                               "scripts"
                               "testkit/src/main"
                               "testkit/src/test"])
                   (defn artifact-selection [default]
                     (let [selection (if (seq *command-line-args*)
                                       (mapv keyword *command-line-args*)
                                       default)]
                       (release/selected (release/modules ".") selection)
                       selection))
                   (defn build! [task selection]
                     (shell "clojure" "-T:build" task ":artifacts" (pr-str selection)))
                   (defn publish! [selection]
                     (doseq [module (release/selected (release/modules ".") selection)]
                       (release/deployable! module))
                     (publish-clojars/publish!
                      {:username (or (System/getenv "CLOJARS_USERNAME") "ramblurr")
                       :token    (System/getenv "CLOJARS_PASSWORD")
                       :command  ["clojure" "-T:build" "deploy" ":artifacts" (pr-str selection)]})))

         dev
         {:doc  "Start a local development server"
          :task (apply clojure "-M:repl/dev:test:dev" *command-line-args*)}

         test
         {:doc  "Run all tests or specific test suites"
          :task (apply clojure "-M:dev:test:kaocha" *command-line-args*)}

         test:integration {:doc  "Run integrations; select with --provider name[,name...]"
                           :task (apply shell "bb" "scripts/run_integration_tests.clj" *command-line-args*)}

         fmt {:doc  "Format code with cljfmt"
              :task (if (seq *command-line-args*)
                      (apply shell "cljfmt --quiet -v fix" (if (seq *command-line-args*) *command-line-args* paths))
                      (do
                        (apply shell "cljfmt --quiet -v fix" paths)
                        (shell "sh" "-c"
                               "cljfmt --config .cljfmt-deps.edn --quiet -v fix deps.edn api/deps.edn providers/*/deps.edn testkit/deps.edn")))}

         fmt:check
         {:doc  "Check code formatting without making changes"
          :task (do
                  (apply shell "cljfmt check" paths)
                  (shell "sh" "-c"
                         "cljfmt --config .cljfmt-deps.edn check deps.edn api/deps.edn providers/*/deps.edn testkit/deps.edn"))}

         deps-tree
         {:doc  "Show dependency tree"
          :task (clojure "-X:deps tree :aliases '[:dev]'")}

         gen-docs
         {:doc "Generate all Antora documentation"
          :task
          (let [modules   (release/modules ".")
                pages-dir "doc/modules/ROOT/pages"]
            (fs/create-dirs (fs/path pages-dir "providers"))
            (doseq [{:keys [id dir]} (rest modules)]
              (fs/copy (fs/path dir "README.adoc")
                       (fs/path pages-dir "providers" (str (name id) ".adoc"))
                       {:replace-existing true}))
            (spit (str (fs/path pages-dir "artifacts.adoc"))
                  (str "= Artifact versions\n\n"
                       "[cols=\"2,1,2\", options=\"header\"]\n|===\n| Maven artifact | Version | Release tag\n"
                       (str/join "\n" (map (fn [{:keys [project tag]}]
                                             (str "| `" (:name project) "` | `" (:version project) "` | `" tag "`"))
                                           modules))
                       "\n|===\n\nProviders bring in the API transitively. Provider and API versions can differ.\n"))
            (gen-docs/generate!
             {:source-paths (conj (vec (mapcat :src-dirs modules)) "testkit/src/main")}))}

         lint:copy-configs
         {:doc  "Copy clj-kondo configs from dependencies"
          :task (shell "clj-kondo" "--lint" (-> (shell {:out :string} "clojure -Spath -M:test:dev") :out str/trim) "--dependencies" "--copy-configs" "--skip-lint")}

         lint
         {:doc  "Lint code with clj-kondo"
          :task (if (seq *command-line-args*)
                  (apply shell "clj-kondo" "--lint" *command-line-args*)
                  (apply shell "clj-kondo --lint" paths))}

         qa
         {:doc     "Run full quality assurance: format, lint, and test"
          :depends [fmt lint test]}

         ci
         {:doc     "Run CI checks: test, format check, and lint"
          :depends [test fmt:check lint]}

         artifacts
         {:doc  "List artifact coordinates, versions, tags, and changelogs"
          :task (print-table
                 (mapv (fn [{:keys [id project tag changelog]}]
                         {:module id  :lib       (:name project) :version (:version project)
                          :tag    tag :changelog changelog})
                       (release/modules ".")))}

         release-notes
         {:doc  "Print one module's changelog entry: bb release-notes [api|provider]"
          :task (let [selected (release/selected (release/modules ".") (artifact-selection :api))]
                  (when-not (= 1 (count selected))
                    (throw (ex-info "Select one artifact for release notes" {})))
                  (print (release/release-notes (first selected))))}

         versions:set
         {:doc  "Set all module versions explicitly: bb versions:set 0.0.1"
          :task (do
                  (when-not (= 1 (count *command-line-args*))
                    (throw (ex-info "Expected one release version" {})))
                  (release/set-versions! "." (first *command-line-args*))
                  (shell "sh" "-c"
                         "cljfmt --config .cljfmt-deps.edn fix api/deps.edn providers/*/deps.edn"))}

         jar {:override-builtin true
              :doc              "Build the API jar, or named modules"
              :task             (build! "jar" (artifact-selection :api))}

         jar:providers {:doc  "Build provider jars; optionally select provider names"
                        :task (build! "jar" (artifact-selection :providers))}

         jar:all {:doc  "Build all release jars"
                  :task (build! "jar" :all)}

         install:all {:doc  "Install all release jars locally, API first"
                      :task (build! "install" :all)}

         clean {:override-builtin true
                :doc              "Clean build artifacts"
                :task             (shell "clojure -T:build clean")}

         publish {:doc  "Publish the API, or named modules, from their release tags"
                  :task (publish! (artifact-selection :api))}

         publish:providers {:doc  "Publish selected providers, default all, from their release tags"
                            :task (publish! (artifact-selection :providers))}

         publish:all {:doc  "Publish API then providers from their release tags"
                      :task (publish! :all)}}}