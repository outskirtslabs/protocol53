;; This the mono repo deps.edn
{:paths   ["api/src/main"]
 :aliases {:dev {:extra-paths ["dev"]
                 :extra-deps  {com.outskirtslabs/protocol53-cloudflare {:local/root "providers/cloudflare"}
                               com.outskirtslabs/protocol53-desec      {:local/root "providers/desec"}
                               com.outskirtslabs/protocol53-godaddy    {:local/root "providers/godaddy"}
                               com.outskirtslabs/protocol53-porkbun    {:local/root "providers/porkbun"}
                               com.outskirtslabs/protocol53-testkit    {:local/root "testkit"}
                               com.cnuernber/charred                   {:mvn/version "1.041"}
                               dev.weavejester/hashp                   {:mvn/version "0.5.1"}
                               metosin/malli                           {:mvn/version "0.20.1"}
                               ol/protocol53                           {:local/root "api"}
                               org.clojure/clojure                     {:mvn/version "1.12.5"}}
                 :jvm-opts    []}

           :test {:extra-paths ["api/src/test"
                                "providers/cloudflare/src/test"
                                "providers/desec/src/test"
                                "providers/godaddy/src/test"
                                "providers/porkbun/src/test"
                                "scripts/test"
                                "testkit/src/test"]
                  :extra-deps  {lambdaisland/kaocha     {:mvn/version "1.91.1392"}
                                org.clojure/test.check  {:mvn/version "1.1.3"}
                                fulcrologic/fulcro-spec {:mvn/version "3.2.10"
                                                         :exclusions
                                                         [colorize/colorize
                                                          com.lucasbradstreet/cljs-uuid-utils]}}}

           :integration-test {:extra-deps {com.outskirtslabs/protocol53-testkit {:local/root "testkit"}
                                           fulcrologic/fulcro-spec              {:mvn/version "3.2.10"}}}

           :kaocha {:extra-deps {lambdaisland/kaocha {:mvn/version "1.91.1392"}}
                    :jvm-opts   ["-Dclojure.tools.logging.factory=clojure.tools.logging.impl/jul-factory"
                                 "-Dguardrails.enabled=true"
                                 "-XX:+UseZGC"
                                 "--enable-native-access=ALL-UNNAMED"]
                    :main-opts  ["-m" "kaocha.runner"]}

           :build {:deps       {io.github.clojure/tools.build {:mvn/version "0.10.14"}
                                slipset/deps-deploy           {:mvn/version "0.2.5"}}
                   :ns-default build}

           :neil {:project {:name        com.outskirtslabs/protocol53
                            :url         "https://docs.outskirtslabs.com/ol.protocol53"
                            :license     {:id "MIT"}
                            :description "One Clojure API for managing DNS records across providers"
                            :platforms   [:clj]
                            :status      :experimental
                            :created     "2026-02-16"
                            :version     "0.0.0"}}

           :debug {:extra-deps {com.clojure-goes-fast/clj-async-profiler {:mvn/version "1.8.0"}
                                com.clojure-goes-fast/clj-memory-meter   {:mvn/version "0.5.0"}
                                criterium/criterium                      {:mvn/version "0.4.6"}}}}}
